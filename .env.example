# Fortnox integration credentials from https://developer.fortnox.se
# Copy to .env and fill in. Never commit the filled-in file.

FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

# Must match the redirect URI registered on the integration, character for character.
FORTNOX_REDIRECT_URI=http://localhost:8000/fortnox/callback

# Space- or comma-separated. Request only what the integration actually needs;
# every extra scope has to be justified in Fortnox's review.
# Common values: companyinformation customer invoice article order offer
#                supplier supplierinvoice bookkeeping settings project
FORTNOX_SCOPES=companyinformation customer invoice

# Where the token pair is persisted (chmod 0600, gitignored).
FORTNOX_TOKEN_PATH=fortnox_token.json

# Optional. Set this to use the client-credentials grant, which mints access tokens
# on demand and needs no refresh token at all. Requires the customer to have activated
# with account_type=service. Find it with `fortnox-auth tenant`, or as DatabaseNumber
# from /3/companyinformation.
# FORTNOX_TENANT_ID=
